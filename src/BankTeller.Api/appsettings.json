{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Bank": "Data Source=bank.db"
  },
  "Bank": {
    "TellerLimit": 20000,
    "MaxTransaction": 1000000,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15
  },
  "Jwt": {
    "Issuer": "BankTeller.Api",
    "Audience": "BankTeller.Desktop",
    "LifetimeMinutes": 30
  },
  "Seed": {
    "Enabled": false
  }
}
